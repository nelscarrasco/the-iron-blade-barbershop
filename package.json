{
  "name": "the-iron-blade-barbershop",
  "private": true,
  "version": "2.0.0",
  "description": "Tienda online The Iron Blade Barbershop - React + React Router + Bootstrap + json-server (DSY1104 Evaluacion Parcial 2)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:api\" \"npm:web\"",
    "web": "vite",
    "api": "json-server --watch server/db.json --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "test": "karma start karma.conf.cjs",
    "reset-db": "node -e \"require('fs').copyFileSync('server/db.seed.json','server/db.json')\"",
    "test:navegador": "karma start karma.conf.cjs --browsers ChromeVisible --no-single-run --auto-watch"
  },
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.12",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^4.6.1",
    "json-server": "^0.17.4",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-esbuild": "^2.3.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-spec-reporter": "^0.0.37",
    "vite": "^6.4.5"
  }
}
