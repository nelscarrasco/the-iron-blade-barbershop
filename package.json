{
  "name": "the-iron-blade-barbershop",
  "private": true,
  "version": "2.0.0",
  "description": "Tienda online The Iron Blade Barbershop - React + React Router + Bootstrap + json-server (DSY1104 Evaluacion Parcial 2)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:api\" \"npm:web\"",
    "web": "vite",
    "api": "json-server --watch server/db.json --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "reset-db": "node -e \"require('fs').copyFileSync('server/db.seed.json','server/db.json')\""
  },
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.5",
    "jsdom": "^26.1.0",
    "json-server": "^0.17.4",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
